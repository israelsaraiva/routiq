    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "https-proxy-agent": "^9.1.0",
    "undici": "^6.29.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
