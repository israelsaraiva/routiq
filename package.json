{
  "name": "routiq",
  "displayName": "Routiq",
  "description": "A lightweight Insomnia/Postman-like REST client inside VS Code.",
  "version": "0.1.7",
  "publisher": "israelsaraiva",
  "author": {
    "name": "Israel Saraiva",
    "email": "israelspm@gmail.com"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/israelsaraiva/routiq.git"
  },
  "bugs": {
    "url": "https://github.com/israelsaraiva/routiq/issues"
  },
  "homepage": "https://github.com/israelsaraiva/routiq#readme",
  "keywords": [
    "rest",
    "http",
    "api",
    "client",
    "graphql",
    "websocket",
    "grpc",
    "sse",
    "postman",
    "insomnia",
    "curl",
    "openapi"
  ],
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "routiq",
          "title": "Routiq",
          "icon": "media/routiq.svg"
        }
      ]
    },
    "views": {
      "routiq": [
        {
          "id": "routiq.collections",
          "name": "Collections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "routiq.collections",
        "contents": "No collections yet.\n[New Collection](command:routiq.newCollection)\n[Import](command:routiq.import)\n[Get Started](command:routiq.openHelp)"
      }
    ],
    "configuration": {
      "title": "Routiq",
      "properties": {
        "routiq.storagePath": {
          "type": "string",
          "default": "",
          "description": "Directory where collections are stored as one JSON file each. Absolute, or relative to the first workspace folder (e.g. \".routiq\"). Empty uses the extension's global storage."
        },
        "routiq.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Select the request of the active editor in the Routiq tree (like explorer.autoReveal). The tree is not focused."
        },
        "routiq.history.maxEntries": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "description": "Maximum number of history entries kept per request."
        },
        "routiq.history.maxBodyBytes": {
          "type": "number",
          "default": 262144,
          "minimum": 0,
          "description": "Maximum response body size (bytes) stored per history entry; larger bodies are truncated."
        },
        "routiq.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1,
          "description": "Request timeout in milliseconds."
        },
        "routiq.followRedirects": {
          "type": "boolean",
          "default": true,
          "description": "Follow HTTP redirects (301, 302, 303, 307, 308)."
        },
        "routiq.maxRedirects": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Maximum number of redirects to follow."
        },
        "routiq.proxy": {
          "type": "string",
          "default": "",
          "description": "Proxy URL (e.g. http://proxy:8080). Empty falls back to VS Code http.proxy, then HTTPS_PROXY/HTTP_PROXY environment variables. NO_PROXY is honoured."
        },
        "routiq.rejectUnauthorized": {
          "type": "boolean",
          "default": true,
          "description": "Verify TLS certificates. Disable to allow self-signed certificates (insecure)."
        },
        "routiq.useVsCodeNetworking": {
          "type": "boolean",
          "default": true,
          "description": "Send HTTP requests through VS Code's networking stack so the system proxy (including PAC files), http.proxy and system certificates apply, like a browser. Ignored when routiq.proxy is set."
        },
        "routiq.curlShell": {
          "type": "string",
          "enum": [
            "auto",
            "bash",
            "powershell",
            "cmd"
          ],
          "default": "auto",
          "description": "Shell syntax used by Copy as cURL. auto uses PowerShell on Windows and bash elsewhere. PowerShell and cmd output curl.exe with the right quoting and line continuations."
        },
        "routiq.scripts.timeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "Maximum run time in milliseconds for each pre-request or post-response script."
        },
        "routiq.runner.delayMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Delay in milliseconds between requests when running a collection or folder."
        }
      }
    },
    "commands": [
      {
        "command": "routiq.moveTo",
        "title": "Move to…",
        "category": "Routiq"
      },
      {
        "command": "routiq.promoteFolder",
        "title": "Promote Folder to Collection",
        "category": "Routiq"
      },
      {
        "command": "routiq.moveCollectionUp",
        "title": "Move Collection Up",
        "category": "Routiq"
      },
      {
        "command": "routiq.moveCollectionDown",
        "title": "Move Collection Down",
        "category": "Routiq"
      },
      {
        "command": "routiq.sortAscending",
        "title": "Sort A→Z",
        "category": "Routiq"
      },
      {
        "command": "routiq.sortDescending",
        "title": "Sort Z→A",
        "category": "Routiq"
      },
      {
        "command": "routiq.sortByMethod",
        "title": "Sort by Method",
        "category": "Routiq"
      },
      {
        "command": "routiq.sortAscendingRecursive",
        "title": "Sort A→Z (Recursive)",
        "category": "Routiq"
      },
      {
        "command": "routiq.sortDescendingRecursive",
        "title": "Sort Z→A (Recursive)",
        "category": "Routiq"
      },
      {
        "command": "routiq.sortByMethodRecursive",
        "title": "Sort by Method (Recursive)",
        "category": "Routiq"
      },
      {
        "command": "routiq.sortCollectionsAscending",
        "title": "Sort Collections A→Z",
        "category": "Routiq"
      },
      {
        "command": "routiq.sortCollectionsDescending",
        "title": "Sort Collections Z→A",
        "category": "Routiq"
      },
      {
        "command": "routiq.clearHistory",
        "title": "Clear Request History",
        "category": "Routiq"
      },
      {
        "command": "routiq.newCollection",
        "title": "New Collection",
        "category": "Routiq",
        "icon": "$(new-folder)"
      },
      {
        "command": "routiq.newRequest",
        "title": "New Request",
        "category": "Routiq",
        "icon": "$(add)"
      },
      {
        "command": "routiq.rename",
        "title": "Rename",
        "category": "Routiq"
      },
      {
        "command": "routiq.delete",
        "title": "Delete",
        "category": "Routiq"
      },
      {
        "command": "routiq.duplicate",
        "title": "Duplicate",
        "category": "Routiq"
      },
      {
        "command": "routiq.import",
        "title": "Import…",
        "category": "Routiq",
        "icon": "$(cloud-download)"
      },
      {
        "command": "routiq.export",
        "title": "Export",
        "category": "Routiq",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "routiq.exportPostman",
        "title": "Export as Postman v2.1…",
        "category": "Routiq"
      },
      {
        "command": "routiq.openRequest",
        "title": "Open Request",
        "category": "Routiq"
      },
      {
        "command": "routiq.newFolder",
        "title": "New Folder",
        "category": "Routiq",
        "icon": "$(new-folder)"
      },
      {
        "command": "routiq.importFromClipboard",
        "title": "Import from Clipboard",
        "category": "Routiq",
        "icon": "$(clippy)"
      },
      {
        "command": "routiq.importCurl",
        "title": "Import cURL",
        "category": "Routiq",
        "icon": "$(terminal)"
      },
      {
        "command": "routiq.copyAsCurl",
        "title": "Copy as cURL",
        "category": "Routiq",
        "icon": "$(copy)"
      },
      {
        "command": "routiq.runCollection",
        "title": "Run Collection/Folder",
        "category": "Routiq",
        "icon": "$(run-all)"
      },
      {
        "command": "routiq.manageEnvironments",
        "title": "Manage Environments",
        "category": "Routiq",
        "icon": "$(server-environment)"
      },
      {
        "command": "routiq.switchEnvironment",
        "title": "Switch Environment",
        "category": "Routiq",
        "icon": "$(server-environment)"
      },
      {
        "command": "routiq.manageCookies",
        "title": "Manage Cookies",
        "category": "Routiq",
        "icon": "$(database)"
      },
      {
        "command": "routiq.searchRequests",
        "title": "Search Requests",
        "category": "Routiq",
        "icon": "$(search)"
      },
      {
        "command": "routiq.filterTree",
        "title": "Filter Requests in Tree",
        "category": "Routiq",
        "icon": "$(filter)"
      },
      {
        "command": "routiq.clearTreeFilter",
        "title": "Clear Tree Filter",
        "category": "Routiq",
        "icon": "$(clear-all)"
      },
      {
        "command": "routiq.openHelp",
        "title": "Help",
        "category": "Routiq",
        "icon": "$(question)"
      },
      {
        "command": "routiq.openAbout",
        "title": "About",
        "category": "Routiq",
        "icon": "$(info)"
      }
    ],
    "submenus": [
      {
        "id": "routiq.sortMenu",
        "label": "Sort"
      }
    ],
    "menus": {
      "routiq.sortMenu": [
        {
          "command": "routiq.sortAscending",
          "group": "1_level@0"
        },
        {
          "command": "routiq.sortDescending",
          "group": "1_level@1"
        },
        {
          "command": "routiq.sortByMethod",
          "group": "1_level@2"
        },
        {
          "command": "routiq.sortAscendingRecursive",
          "group": "2_recursive@0"
        },
        {
          "command": "routiq.sortDescendingRecursive",
          "group": "2_recursive@1"
        },
        {
          "command": "routiq.sortByMethodRecursive",
          "group": "2_recursive@2"
        }
      ],
      "view/title": [
        {
          "command": "routiq.sortCollectionsAscending",
          "when": "view == routiq.collections",
          "group": "2_sort@1"
        },
        {
          "command": "routiq.sortCollectionsDescending",
          "when": "view == routiq.collections",
          "group": "2_sort@2"
        },
        {
          "command": "routiq.newCollection",
          "when": "view == routiq.collections",
          "group": "navigation@1"
        },
        {
          "command": "routiq.import",
          "when": "view == routiq.collections",
          "group": "navigation@2"
        },
        {
          "command": "routiq.importFromClipboard",
          "when": "view == routiq.collections",
          "group": "navigation@3"
        },
        {
          "command": "routiq.export",
          "when": "view == routiq.collections",
          "group": "navigation@4"
        },
        {
          "command": "routiq.switchEnvironment",
          "when": "view == routiq.collections",
          "group": "1_environment@1"
        },
        {
          "command": "routiq.searchRequests",
          "when": "view == routiq.collections",
          "group": "navigation@0"
        },
        {
          "command": "routiq.filterTree",
          "when": "view == routiq.collections && !routiq.treeFiltered",
          "group": "navigation@5"
        },
        {
          "command": "routiq.clearTreeFilter",
          "when": "view == routiq.collections && routiq.treeFiltered",
          "group": "navigation@5"
        },
        {
          "command": "routiq.openHelp",
          "when": "view == routiq.collections",
          "group": "9_help@1"
        },
        {
          "command": "routiq.openAbout",
          "when": "view == routiq.collections",
          "group": "9_help@2"
        }
      ],
      "view/item/context": [
        {
          "command": "routiq.moveTo",
          "when": "viewItem =~ /^(collection|folder|request)$/",
          "group": "3_manage@4"
        },
        {
          "command": "routiq.promoteFolder",
          "when": "viewItem == folder",
          "group": "3_manage@5"
        },
        {
          "command": "routiq.moveCollectionUp",
          "when": "viewItem == collection",
          "group": "3_manage@6"
        },
        {
          "command": "routiq.moveCollectionDown",
          "when": "viewItem == collection",
          "group": "3_manage@7"
        },
        {
          "submenu": "routiq.sortMenu",
          "when": "viewItem =~ /^(collection|folder)$/",
          "group": "3_manage@0"
        },
        {
          "command": "routiq.openRequest",
          "when": "viewItem == request",
          "group": "1_edit@0"
        },
        {
          "command": "routiq.newRequest",
          "when": "viewItem =~ /^(collection|folder)$/",
          "group": "inline@1"
        },
        {
          "command": "routiq.newFolder",
          "when": "viewItem =~ /^(collection|folder)$/",
          "group": "inline@2"
        },
        {
          "command": "routiq.newRequest",
          "when": "viewItem =~ /^(collection|folder)$/",
          "group": "1_edit@1"
        },
        {
          "command": "routiq.newFolder",
          "when": "viewItem =~ /^(collection|folder)$/",
          "group": "1_edit@2"
        },
        {
          "command": "routiq.importCurl",
          "when": "viewItem =~ /^(collection|folder)$/",
          "group": "1_edit@3"
        },
        {
          "command": "routiq.import",
          "when": "viewItem =~ /^(collection|folder)$/",
          "group": "1_edit@4"
        },
        {
          "command": "routiq.importFromClipboard",
          "when": "viewItem =~ /^(collection|folder)$/",
          "group": "1_edit@5"
        },
        {
          "command": "routiq.runCollection",
          "when": "viewItem =~ /^(collection|folder)$/",
          "group": "3_run@1"
        },
        {
          "command": "routiq.manageEnvironments",
          "when": "viewItem == collection",
          "group": "2_env@1"
        },
        {
          "command": "routiq.switchEnvironment",
          "when": "viewItem == collection",
          "group": "2_env@2"
        },
        {
          "command": "routiq.export",
          "when": "viewItem == collection",
          "group": "2_io@1"
        },
        {
          "command": "routiq.exportPostman",
          "when": "viewItem == collection",
          "group": "2_io@2"
        },
        {
          "command": "routiq.copyAsCurl",
          "when": "viewItem == request",
          "group": "2_io@1"
        },
        {
          "command": "routiq.rename",
          "when": "viewItem =~ /^(collection|folder|request)$/",
          "group": "3_manage@1"
        },
        {
          "command": "routiq.duplicate",
          "when": "viewItem =~ /^(collection|folder|request)$/",
          "group": "3_manage@2"
        },
        {
          "command": "routiq.delete",
          "when": "viewItem =~ /^(collection|folder|request)$/",
          "group": "3_manage@3"
        },
        {
          "command": "routiq.manageCookies",
          "when": "viewItem == collection",
          "group": "2_env@3"
        }
      ],
      "commandPalette": [
        {
          "command": "routiq.moveTo",
          "when": "false"
        },
        {
          "command": "routiq.promoteFolder",
          "when": "false"
        },
        {
          "command": "routiq.moveCollectionUp",
          "when": "false"
        },
        {
          "command": "routiq.moveCollectionDown",
          "when": "false"
        },
        {
          "command": "routiq.sortAscending",
          "when": "false"
        },
        {
          "command": "routiq.sortDescending",
          "when": "false"
        },
        {
          "command": "routiq.sortByMethod",
          "when": "false"
        },
        {
          "command": "routiq.sortAscendingRecursive",
          "when": "false"
        },
        {
          "command": "routiq.sortDescendingRecursive",
          "when": "false"
        },
        {
          "command": "routiq.sortByMethodRecursive",
          "when": "false"
        },
        {
          "command": "routiq.openRequest",
          "when": "false"
        },
        {
          "command": "routiq.copyAsCurl",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "harness": "node esbuild.js && node scripts/webview-harness/run.js",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "icon": "node scripts/renderIcon.js",
    "vscode:prepublish": "npm run build",
    "test:integration": "node esbuild.js && node scripts/buildIntegrationTests.js && node dist-test/runTest.js"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "jsdom": "^30.1.3",
    "mocha": "^12.0.3",
    "playwright": "^1.64.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
